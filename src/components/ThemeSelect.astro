---
// Custom theme switcher. Replaces Starlight's native <select> with a fully
// styled button + listbox so the option menu can be themed (native <option>
// elements can't be styled). Keeps the <starlight-theme-select> tag and the
// `svg.label-icon` so StarlightThemeProvider.updatePickers() still swaps the
// trigger icon, and reuses the same localStorage logic as upstream.
import { Icon } from '@astrojs/starlight/components';

const accessibleLabel = Astro.locals.t('themeSelect.accessibleLabel');
const options = [
  { value: 'dark', label: Astro.locals.t('themeSelect.dark'), icon: 'moon' },
  { value: 'light', label: Astro.locals.t('themeSelect.light'), icon: 'sun' },
  { value: 'auto', label: Astro.locals.t('themeSelect.auto'), icon: 'laptop' },
] as const;
---

<starlight-theme-select>
  <div class="mh-theme-select">
    <button
      type="button"
      class="mh-theme-trigger"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={accessibleLabel}
    >
      <Icon name="laptop" class="icon label-icon" />
      <span class="mh-theme-current" data-current-label>{Astro.locals.t('themeSelect.auto')}</span>
      <Icon name="down-caret" class="icon caret" />
    </button>
    <ul class="mh-theme-menu" role="listbox" aria-label={accessibleLabel} hidden>
      {
        options.map((o) => (
          <li
            class="mh-theme-option"
            role="option"
            tabindex="-1"
            data-value={o.value}
            aria-selected={o.value === 'auto' ? 'true' : 'false'}
          >
            <Icon name={o.icon} class="mh-opt-icon" />
            <span class="mh-opt-label">{o.label}</span>
            <Icon name="approve-check" class="mh-opt-check" />
          </li>
        ))
      }
    </ul>
  </div>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro`. */}
<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  const storageKey = 'starlight-theme';

  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
    }
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  /** Update document theme + local storage, and sync every picker's icon. */
  function onThemeChange(theme: Theme): void {
    StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
    storeTheme(theme);
  }

  // React to system color-scheme changes while in `auto`.
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') onThemeChange('auto');
  });

  class StarlightThemeSelect extends HTMLElement {
    #btn: HTMLButtonElement;
    #menu: HTMLUListElement;
    #currentLabel: HTMLElement;
    #options: HTMLLIElement[];

    constructor() {
      super();
      this.#btn = this.querySelector('.mh-theme-trigger')!;
      this.#menu = this.querySelector('.mh-theme-menu')!;
      this.#currentLabel = this.querySelector('[data-current-label]')!;
      this.#options = Array.from(this.querySelectorAll('.mh-theme-option'));

      this.#syncUI(loadTheme());
      onThemeChange(loadTheme());

      this.#btn.addEventListener('click', () => this.#toggle());
      this.#btn.addEventListener('keydown', (e) => this.#onTriggerKey(e));

      this.#options.forEach((opt) => {
        opt.addEventListener('click', () => this.#select(parseTheme(opt.dataset.value)));
        opt.addEventListener('keydown', (e) => this.#onOptionKey(e, opt));
      });

      // Close on outside click / Escape / focus leaving the widget.
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target as Node)) this.#close();
      });
      this.addEventListener('focusout', (e) => {
        if (!this.contains(e.relatedTarget as Node)) this.#close();
      });
    }

    #labelFor(value: string): string {
      const opt = this.#options.find((o) => o.dataset.value === value);
      return opt?.querySelector('.mh-opt-label')?.textContent ?? value;
    }

    #syncUI(theme: Theme): void {
      this.#currentLabel.textContent = this.#labelFor(theme);
      this.#options.forEach((o) =>
        o.setAttribute('aria-selected', String(o.dataset.value === theme))
      );
    }

    get #isOpen(): boolean {
      return this.#btn.getAttribute('aria-expanded') === 'true';
    }

    #toggle(): void {
      this.#isOpen ? this.#close() : this.#open();
    }

    #open(): void {
      this.#menu.hidden = false;
      this.#btn.setAttribute('aria-expanded', 'true');
      const selected =
        this.#options.find((o) => o.getAttribute('aria-selected') === 'true') ?? this.#options[0];
      selected?.focus();
    }

    #close(): void {
      if (!this.#isOpen) return;
      this.#menu.hidden = true;
      this.#btn.setAttribute('aria-expanded', 'false');
    }

    #select(theme: Theme): void {
      onThemeChange(theme);
      this.#syncUI(theme);
      this.#close();
      this.#btn.focus();
    }

    #onTriggerKey(e: KeyboardEvent): void {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        this.#open();
      }
    }

    #onOptionKey(e: KeyboardEvent, opt: HTMLLIElement): void {
      const i = this.#options.indexOf(opt);
      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          this.#options[(i + 1) % this.#options.length].focus();
          break;
        case 'ArrowUp':
          e.preventDefault();
          this.#options[(i - 1 + this.#options.length) % this.#options.length].focus();
          break;
        case 'Enter':
        case ' ':
          e.preventDefault();
          this.#select(parseTheme(opt.dataset.value));
          break;
        case 'Escape':
          e.preventDefault();
          this.#close();
          this.#btn.focus();
          break;
        case 'Tab':
          this.#close();
          break;
      }
    }
  }

  customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
  .mh-theme-select {
    position: relative;
  }

  /* Trigger — mirrors Starlight's Select look. */
  .mh-theme-trigger {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding-block: 0.5rem;
    padding-inline: calc(0.875rem + 0.5rem) 0.5rem;
    position: relative;
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .mh-theme-trigger:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }

  .mh-theme-trigger[aria-expanded='true'] {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
  }

  .mh-theme-trigger:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .mh-theme-current {
    flex: 1;
    text-align: start;
  }

  .mh-theme-trigger .label-icon {
    position: absolute;
    inset-inline-start: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.875rem;
    pointer-events: none;
  }

  .mh-theme-trigger .caret {
    font-size: 1rem;
    transition: transform 0.15s ease;
  }

  .mh-theme-trigger[aria-expanded='true'] .caret {
    transform: rotate(180deg);
  }

  /* Menu panel. */
  .mh-theme-menu {
    position: absolute;
    z-index: 50;
    inset-inline-start: 0;
    top: calc(100% + 0.375rem);
    min-width: 100%;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background-color: var(--sl-color-bg-nav, var(--sl-color-black));
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
  }

  .mh-theme-menu[hidden] {
    display: none;
  }

  .mh-theme-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.4rem;
    padding-inline: 0.5rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    line-height: 1;
    cursor: pointer;
    user-select: none;
  }

  .mh-theme-option:hover,
  .mh-theme-option:focus-visible {
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    outline: none;
  }

  .mh-theme-option[aria-selected='true'] {
    color: var(--sl-color-accent-high, var(--sl-color-accent));
    font-weight: 600;
  }

  .mh-opt-icon {
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .mh-opt-label {
    flex: 1;
  }

  /* Check mark only on the active option. */
  .mh-opt-check {
    font-size: 0.875rem;
    flex-shrink: 0;
    opacity: 0;
  }

  .mh-theme-option[aria-selected='true'] .mh-opt-check {
    opacity: 1;
  }
</style>
