---
// Mobile menu drawer footer. The theme control is intentionally omitted here —
// on mobile we use the compact sun/moon toggle in the header bar instead
// (see MobileThemeToggle.astro). Only social + language preferences remain.
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
---

<div class="mobile-preferences sl-flex">
  <div class="social-icons">
    <SocialIcons />
  </div>
  <LanguageSelect />
</div>

<style>
  @layer starlight.core {
    .social-icons {
      display: flex;
      margin-inline-end: auto;
      gap: 1rem;
      align-items: center;
      padding-block: 1rem;
    }
    .social-icons:empty {
      display: none;
    }
    .mobile-preferences {
      justify-content: space-between;
      flex-wrap: wrap;
      border-top: 1px solid var(--sl-color-gray-6);
      column-gap: 1rem;
      padding: 0.5rem 0;
    }
  }
</style>
