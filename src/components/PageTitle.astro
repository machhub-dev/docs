---
// Custom PageTitle override — renders a "Contribute" button above each page's
// heading so readers can jump straight to editing the source on GitHub. The edit
// URL comes from Starlight's `editLink` config (astro.config.mjs).
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { editUrl } = Astro.locals.starlightRoute;
---

{
  editUrl && (
    <a
      class="mh-contribute"
      href={editUrl.href}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        aria-hidden="true"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
      </svg>
      <span>Contribute to this page</span>
    </a>
  )
}

<Default><slot /></Default>

<style>
  .mh-contribute {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-end: 0.25rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1;
    color: var(--sl-color-gray-1);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .mh-contribute:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-6);
  }
</style>
